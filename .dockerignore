# 构建产物与无关文件不进镜像，减小体积并避免泄漏本地配置
.venv/
.uv-cache/
__pycache__/
*.py[cod]
*.pyc

# 敏感配置：绝不进镜像，运行时通过环境变量或挂载注入
.env
.env.*

# 运行时与测试产物
app/output/
app/updated/
logs/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 前端产物由独立前端镜像负责
frontend/node_modules/
frontend/dist/

# 版本控制与文档
.git/
.gitignore
docs/
*.md
